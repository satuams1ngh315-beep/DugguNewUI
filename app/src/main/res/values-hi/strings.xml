    <!-- Register: step headings -->
    <string name="auth_step_name_title">आपका नाम क्या है?</string>
    <string name="auth_step_name_body">यह वही नाम है जो विक्रेता और डिलीवरी पार्टनर आपके ऑर्डर पर देखेंगे।</string>
    <string name="auth_step_name_illustration">थोड़ी सी अपनी पहचान हर ऑर्डर को खास बना देती है।</string>
    <string name="auth_step_email_title">आपका ईमेल क्या है?</string>
    <string name="auth_step_email_body">आप इसी से साइन इन करेंगे, और हम ऑर्डर अपडेट यहीं भेजेंगे।</string>
    <string name="auth_step_email_illustration">हम कभी स्पैम नहीं भेजेंगे — सिर्फ ऑर्डर अपडेट और रसीदें।</string>
    <string name="auth_step_phone_title">आपका मोबाइल नंबर</string>
    <string name="auth_step_phone_body">अगर डिलीवरी पार्टनर या दुकान आपको ढूँढ न पाए, तो इसी नंबर पर कॉल करेंगे।</string>
    <string name="auth_step_phone_illustration">सिर्फ तभी उपयोग होगा जब डिलीवरी पार्टनर या दुकान को आपसे किसी ऑर्डर के बारे में बात करनी हो।</string>
    <string name="auth_phone_progress">%1$d / 10 अंक</string>
    <string name="auth_step_role_title">आप Duggu Store का उपयोग कैसे करेंगे?</string>
    <string name="auth_step_role_body">जो आप पर लागू हो वह चुनें — विक्रेता और डिलीवरी पार्टनर को इसके बाद एक छोटी वेरिफिकेशन प्रक्रिया से गुज़रना होगा।</string>
    <string name="auth_role_shop_blurb">डिलीवरी के लिए किराना और ज़रूरी सामान ऑर्डर करें।</string>
    <string name="auth_role_sell_blurb">अपनी दुकान के उत्पाद सूचीबद्ध करें और ऑर्डर लें।</string>
    <string name="auth_role_deliver_blurb">आस-पास के ऑर्डर उठाएँ और प्रति डिलीवरी कमाएँ।</string>
    <string name="auth_step_password_title">पासवर्ड बनाएँ</string>
    <string name="auth_step_password_body">हर बार साइन इन करते समय आप इसे अपने ईमेल के साथ उपयोग करेंगे।</string>
    <string name="auth_step_password_illustration">कुछ ऐसा चुनें जिसका अंदाज़ा सिर्फ आप ही लगा सकें।</string>
