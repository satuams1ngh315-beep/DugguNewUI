    <!-- Register: step headings -->
    <string name="auth_step_name_title">ਤੁਹਾਡਾ ਨਾਂ ਕੀ ਹੈ?</string>
    <string name="auth_step_name_body">ਇਹੀ ਨਾਂ ਵਿਕਰੇਤਾ ਅਤੇ ਡਿਲੀਵਰੀ ਪਾਰਟਨਰ ਤੁਹਾਡੇ ਆਰਡਰ ਉੱਤੇ ਦੇਖਣਗੇ।</string>
    <string name="auth_step_name_illustration">ਥੋੜ੍ਹੀ ਜਿਹੀ ਆਪਣੀ ਪਛਾਣ ਹਰ ਆਰਡਰ ਨੂੰ ਖਾਸ ਬਣਾ ਦਿੰਦੀ ਹੈ।</string>
    <string name="auth_step_email_title">ਤੁਹਾਡੀ ਈਮੇਲ ਕੀ ਹੈ?</string>
    <string name="auth_step_email_body">ਤੁਸੀਂ ਇਸੇ ਨਾਲ ਸਾਈਨ ਇਨ ਕਰੋਗੇ, ਅਤੇ ਅਸੀਂ ਆਰਡਰ ਅਪਡੇਟ ਇੱਥੇ ਹੀ ਭੇਜਾਂਗੇ।</string>
    <string name="auth_step_email_illustration">ਅਸੀਂ ਕਦੇ ਸਪੈਮ ਨਹੀਂ ਭੇਜਾਂਗੇ — ਸਿਰਫ਼ ਆਰਡਰ ਅਪਡੇਟ ਅਤੇ ਰਸੀਦਾਂ।</string>
    <string name="auth_step_phone_title">ਤੁਹਾਡਾ ਮੋਬਾਈਲ ਨੰਬਰ</string>
    <string name="auth_step_phone_body">ਜੇ ਡਿਲੀਵਰੀ ਪਾਰਟਨਰ ਜਾਂ ਦੁਕਾਨ ਤੁਹਾਨੂੰ ਲੱਭ ਨਾ ਸਕੇ, ਤਾਂ ਇਸੇ ਨੰਬਰ ਉੱਤੇ ਕਾਲ ਕਰਨਗੇ।</string>
    <string name="auth_step_phone_illustration">ਸਿਰਫ਼ ਉਦੋਂ ਵਰਤਿਆ ਜਾਵੇਗਾ ਜਦੋਂ ਡਿਲੀਵਰੀ ਪਾਰਟਨਰ ਜਾਂ ਦੁਕਾਨ ਨੂੰ ਤੁਹਾਡੇ ਨਾਲ ਕਿਸੇ ਆਰਡਰ ਬਾਰੇ ਗੱਲ ਕਰਨੀ ਹੋਵੇ।</string>
    <string name="auth_phone_progress">%1$d / 10 ਅੰਕ</string>
    <string name="auth_step_role_title">ਤੁਸੀਂ Duggu Store ਦੀ ਵਰਤੋਂ ਕਿਵੇਂ ਕਰੋਗੇ?</string>
    <string name="auth_step_role_body">ਜੋ ਤੁਹਾਡੇ ਉੱਤੇ ਢੁਕਦਾ ਹੈ ਉਹ ਚੁਣੋ — ਵਿਕਰੇਤਾ ਅਤੇ ਡਿਲੀਵਰੀ ਪਾਰਟਨਰ ਨੂੰ ਇਸ ਤੋਂ ਬਾਅਦ ਇੱਕ ਛੋਟੀ ਤਸਦੀਕ ਪ੍ਰਕਿਰਿਆ ਵਿੱਚੋਂ ਲੰਘਣਾ ਪਵੇਗਾ।</string>
    <string name="auth_role_shop_blurb">ਡਿਲੀਵਰੀ ਲਈ ਕਰਿਆਨਾ ਅਤੇ ਜ਼ਰੂਰੀ ਸਮਾਨ ਆਰਡਰ ਕਰੋ।</string>
    <string name="auth_role_sell_blurb">ਆਪਣੀ ਦੁਕਾਨ ਦੇ ਉਤਪਾਦ ਸੂਚੀਬੱਧ ਕਰੋ ਅਤੇ ਆਰਡਰ ਲਓ।</string>
    <string name="auth_role_deliver_blurb">ਨੇੜਲੇ ਆਰਡਰ ਚੁੱਕੋ ਅਤੇ ਹਰ ਡਿਲੀਵਰੀ ਉੱਤੇ ਕਮਾਓ।</string>
    <string name="auth_step_password_title">ਪਾਸਵਰਡ ਬਣਾਓ</string>
    <string name="auth_step_password_body">ਹਰ ਵਾਰ ਸਾਈਨ ਇਨ ਕਰਦੇ ਸਮੇਂ ਤੁਸੀਂ ਇਸਨੂੰ ਆਪਣੀ ਈਮੇਲ ਨਾਲ ਵਰਤੋਗੇ।</string>
    <string name="auth_step_password_illustration">ਕੁਝ ਅਜਿਹਾ ਚੁਣੋ ਜਿਸਦਾ ਅੰਦਾਜ਼ਾ ਸਿਰਫ਼ ਤੁਸੀਂ ਹੀ ਲਗਾ ਸਕੋ।</string>
    <string name="auth_requirement_password_length">ਘੱਟੋ-ਘੱਟ 6 ਅੱਖਰ</string>
